# Copy this file to .env and then edit values for your local environment.
PORT=
FRONTEND_ORIGIN=
MONGODB_URI=mongodb://
MONGODB_DB=
ENCRYPTION_KEY=

# Dirección pública del frontend (para los enlaces de los correos) y nombre de la plataforma
APP_URL=http://localhost:8065
APP_NOMBRE=Educación Rural
# Zona horaria de las fechas en los correos
APP_ZONA_HORARIA=America/Santiago

# Correos: "smtp" envía con los datos SMTP_*; "registro" solo los muestra en la consola
# (bandeja de prueba). Si se omite, se usa "smtp" cuando SMTP_HOST está definido.
CORREO_TRANSPORTE=
CORREO_REMITENTE=Educación Rural <postmaster@tu-dominio>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Firma de los enlaces para dejar de recibir avisos; si se omite se usa ENCRYPTION_KEY
CORREO_SECRETO=

# Sesiones: secreto para firmar los tokens de inicio de sesión y días de vigencia.
# Si TOKEN_SECRETO se omite, se deriva de ENCRYPTION_KEY. Cambiarlo cierra todas las sesiones.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_SECRETO=
TOKEN_DIAS_VIGENCIA=7
